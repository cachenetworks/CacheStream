# =========================================================
# CacheStream — minimal bootstrap config
# =========================================================
# As of v1.7, almost everything is configured via the panel
# (Settings tab / first-run wizard at /setup). Only the values
# below are needed BEFORE the panel can start — once the
# wizard finishes, you can forget this file exists.
#
# Copy to `.env`, fill in PUBLIC_URL, run `docker compose up -d`,
# open https://<your-domain>/ and follow the wizard.
# =========================================================


# =============================================
# Required: public hostname for OAuth callbacks
# =============================================
# The hostname your Cloudflare Tunnel (or other reverse proxy)
# routes to this container. Used to build the OAuth redirect URL
# you'll register on the Twitch developer console during setup.
#
# Examples:
#   https://stream.example.com
#   http://localhost:7788     (local dev only)
PUBLIC_URL=https://stream.example.com


# =============================================
# Optional: web container behaviour
# =============================================
# Port the Next.js server binds. Cloudflare Tunnel should point
# to http://<host>:<WEB_PORT>.
WEB_PORT=7788

# RTMP ingest port (v1.9.0+). Lets you push from OBS or any RTMP
# encoder to rtmp://<host>:1935/live using the stream key shown
# on the panel's Stream Info card. Only this port is published;
# the HLS unwrap stays internal to the compose network.
RTMP_PORT=1935

# Optional: explicit hostname/IP the panel should show operators
# for the OBS push URL. Defaults to PUBLIC_URL's hostname; falls
# back to the panel's request host. Set this if PUBLIC_URL is a
# tunneled https domain that does NOT also reach the host on
# :1935 — for example, when your Cloudflare Tunnel is on one
# machine and the streamer is on another, or when OBS pushes to
# a LAN IP while the panel is on a public DNS name.
# RTMP_PUBLIC_HOST=10.0.0.5

# Trust X-Forwarded-* headers from a reverse proxy. Required for
# Secure cookies + correct client-IP logging when fronted by
# Cloudflare Tunnel / nginx / Caddy.
TRUST_PROXY=true

# Internal bearer token shared between the web + streamer
# containers. Auto-generated at first boot if left blank — the
# value is written to a shared volume file the streamer reads
# on startup. Pin a value here only for reproducible deploys
# (e.g. CI tests that need a known token).
INTERNAL_API_TOKEN=

# Internal RPC URL. Inside docker compose the default works; only
# change if you're running the streamer on a different host.
STREAMER_URL=http://streamer:7789


# =============================================
# Optional: data + media paths
# =============================================
# Where SQLite + branding logos + cover art live.
DATA_DIR=/app/data

# Where music + VODs live (mounted from ./media on the host).
MUSIC_LIBRARY_DIR=/app/media/music
VOD_LIBRARY_DIR=/app/media/vods


# =============================================
# Pre-wizard / advanced overrides (rarely needed)
# =============================================
# The setup wizard will fill these in for you. Only set them
# here if you want a headless / CI deploy that never touches the
# wizard UI. Anything you DO set here wins over the wizard.
#
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# SESSION_SECRET=
# TWITCH_STREAM_KEY=
# TWITCH_INGEST_URL=rtmp://live.twitch.tv/app
#
# Encoder knobs (all auto-detected by default; override only if
# you know what you're doing):
# STREAM_PROFILE=auto
# STREAM_WIDTH=
# STREAM_HEIGHT=
# STREAM_FPS=
# STREAM_VIDEO_BITRATE=
# STREAM_VIDEO_MAXRATE=
# STREAM_VIDEO_BUFSIZE=
# STREAM_PRESET=
# STREAM_X264_THREADS=
# STREAM_X264_TUNE=
# STREAM_VIDEO_CODEC=
# STREAM_SCREENCAST_QUALITY=
# STREAM_CAPTURE_EVERY_NTH=
#
# Chromium GPU rasterisation: auto | on | off (default auto).
# Scenes only "move" as fast as Chromium repaints them. Forcing
# the CPU software compositor (off) caps a Pi at ~3 fps on the
# animated scenes. `auto` enables the GPU on a Pi or any host with
# a /dev/dri render node; pass /dev/dri into the streamer
# container for it to take effect (see docker-compose.pi.yml).
# This is separate from the h264_v4l2m2m HW encoder, so it also
# helps the Pi 5. Set `off` to restore the old software path.
# STREAM_CHROMIUM_GPU=auto
# STREAM_THERMAL_MONITOR=true
# STREAM_THERMAL_THROTTLE_C=80
# STREAM_THERMAL_RECOVER_C=68
#
# Runtime knobs:
LOG_LEVEL=info
# RECONNECT_DELAY_SECONDS=5
# AUTO_START_STREAM=false
# INITIAL_OWNER_LOGIN=
#
# Long-stream stability (v1.13.3):
# STREAM_WATCHDOG_TIMEOUT_SECONDS=30
#   If state=running but no frames have flowed to FFmpeg for this
#   many seconds, force a reconnect. Catches silent-death cases
#   where nothing crashes but the broadcast stalls. 0 = disabled.
# STREAM_BROWSER_RECYCLE_HOURS=6
#   Proactively restart the Chromium + FFmpeg pipeline after this
#   many hours of healthy uptime. Defends against Chromium memory
#   bloat on long streams. 0 = disabled.
# STREAM_TEARDOWN_TIMEOUT_SECONDS=10
#   Hard deadline for cleaning up between reconnects. Past this,
#   leftover processes get SIGKILL'd and the next cycle proceeds.
# STREAM_MEMORY_RECYCLE_LIMIT_MB=1500
#   If the streamer process RSS exceeds this many megabytes, the
#   watchdog forces an immediate pipeline recycle (frees Chromium +
#   FFmpeg memory). Catches fast leaks before the host OOM-kills
#   us. 0 = disabled.
